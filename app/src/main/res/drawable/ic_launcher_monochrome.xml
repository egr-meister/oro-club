<?xml version="1.0" encoding="utf-8"?>
<!-- Themed (monochrome) launcher icon: the Oro Club orbit mark, single colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Crown -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,26 L47,13 L54,21 L61,13 L68,26 Z" />

    <!-- Orbit ring (tilted ellipse) -->
    <group
        android:pivotX="54"
        android:pivotY="60"
        android:rotation="-18">
        <path
            android:pathData="M54,46 m-32,0 a32,14 0 1,0 64,0 a32,14 0 1,0 -64,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="5" />
    </group>

    <!-- Planet body -->
    <path
        android:pathData="M54,46 m-21,0 a21,21 0 1,0 42,0 a21,21 0 1,0 -42,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="8" />

    <!-- Base bar (the "Club" underline) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,84 h44 v6 h-44 z" />
</vector>
