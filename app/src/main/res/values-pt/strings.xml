    <!-- Rules -->
    <string name="rules_title">Regras do jogo</string>
    <string name="rules_quiz_title">Quiz</string>
    <string name="rules_quiz_body">Escolha um dos três baralhos temáticos. Cada baralho tem dez perguntas com uma única resposta certa. Toque numa resposta e ela é revelada de imediato — a opção certa é marcada com um visto e uma escolha errada com uma cruz — e depois a pergunta seguinte surge sozinha. A sua melhor pontuação por baralho é guardada.</string>
    <string name="rules_pairs_title">Encontrar pares</string>
    <string name="rules_pairs_body">Nove níveis, cada um com mais cartas e mais tempo. Vire duas cartas: um par igual fica virado para cima, um erro volta a virar-se. Encontre todos os pares antes de o tempo acabar para vencer o nível. Conclua um nível para desbloquear o seguinte.</string>
    <string name="rules_pause_title">Pausa</string>
    <string name="rules_pause_body">Toque na ficha de pausa a qualquer momento. O tempo para enquanto o painel está aberto, e pode continuar, reiniciar a ronda ou voltar ao menu.</string>
    <string name="rules_progress_title">O seu progresso</string>
    <string name="rules_progress_body">As melhores pontuações do quiz, os níveis concluídos e o interruptor de som são guardados neste dispositivo e em mais lado nenhum. Reponha-os quando quiser nas definições.</string>
    <string name="rules_fair_title">Jogo justo</string>
    <string name="rules_fair_body">Oro Club é um jogo para um jogador e de entretenimento. Não há apostas, jogo a dinheiro real, prémios nem qualquer componente online.</string>
    <string name="rules_footer">Oro Club — O clube dourado do joker</string>

