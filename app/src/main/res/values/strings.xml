<?xml version="1.0" encoding="utf-8"?>
<!--
  English is the DEFAULT (values/) locale: the fallback for every system language not
  shipped as its own values-xx. Russian lives in values-ru. Keep every name= in sync
  across all seven files (scripts/check_locales.sh) or the app crashes on the locale
  that is missing a key.

  Quiz questions, category titles and match-icon names are game DATA kept in Kotlin and
  deliberately not localised here.
-->
