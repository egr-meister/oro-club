    <!-- Rules -->
    <string name="rules_title">Game Rules</string>
    <string name="rules_quiz_title">Quiz</string>
    <string name="rules_quiz_body">Pick one of three themed decks. Each deck holds ten questions with one correct answer. Tap an answer and it is revealed immediately — the correct option is marked with a check, a wrong pick with a cross — then the next question arrives on its own. Your best score per deck is kept.</string>
    <string name="rules_pairs_title">Matching Pairs</string>
    <string name="rules_pairs_body">Nine levels, each with more cards and a longer clock. Flip two cards: a matching pair stays face up, a mismatch turns back over. Clear every pair before the timer runs out to win the level. Finish a level to unlock the next one.</string>
    <string name="rules_pause_title">Pause</string>
    <string name="rules_pause_body">Tap the pause token at any time. The clock stops while the panel is open, and you can continue, restart the round, or step back to the menu.</string>
    <string name="rules_progress_title">Your progress</string>
    <string name="rules_progress_body">Best quiz scores, cleared levels and the sound switch are saved on this device and nowhere else. Reset them any time from Settings.</string>
    <string name="rules_fair_title">Fair play</string>
    <string name="rules_fair_body">Oro Club is a single-player game for entertainment. There is no wagering, no real-money play, no prizes and no online component of any kind.</string>
    <string name="rules_footer">Oro Club — Golden Joker Club</string>

